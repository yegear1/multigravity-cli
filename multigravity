#!/usr/bin/env bash
set -euo pipefail

shopt -s nullglob

REAL_HOME="${REAL_HOME:-}"
if [ -z "$REAL_HOME" ] || [[ "$REAL_HOME" == *"/AntigravityProfiles/"* ]]; then
  if command -v getent >/dev/null 2>&1; then
    REAL_HOME="$(getent passwd "${USER:-${LOGNAME:-}}" 2>/dev/null | cut -d: -f6 || true)"
  fi
  if [ -z "$REAL_HOME" ]; then
    REAL_HOME="$(eval echo "~${USER:-${LOGNAME:-}}" 2>/dev/null || true)"
  fi
  if [ -z "$REAL_HOME" ] || [[ "$REAL_HOME" == *"/AntigravityProfiles/"* ]]; then
    if [[ "$HOME" == *"/AntigravityProfiles/"* ]]; then
      REAL_HOME="${HOME%%/AntigravityProfiles/*}"
    else
      REAL_HOME="$HOME"
    fi
  fi
fi
BASE="${MULTIGRAVITY_HOME:-$REAL_HOME/AntigravityProfiles}"
VERSION="1.4.1"
cmd="${1-}"

abort() {
  echo "Error: $1" >&2
  exit 1
}

print_info() {
  echo "$1"
}

platform() {
  local raw
  raw="${MULTIGRAVITY_PLATFORM-}"
  if [ -z "$raw" ]; then
    raw="$(uname -s)"
  fi

  raw="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"

  case "$raw" in
    darwin | macos | mac | osx)
      printf '%s\n' "darwin"
      ;;
    linux)
      printf '%s\n' "linux"
      ;;
    *)
      abort "unsupported platform '$raw'. Multigravity supports macOS and Linux."
      ;;
  esac
}

profile_dir() {
  printf '%s/%s\n' "$BASE" "$1"
}

templates_dir() {
  printf '%s/.templates\n' "$BASE"
}

is_shared_profile() {
  [ -f "$(profile_dir "$1")/.shared" ]
}

user_data_dir() {
  local profile_path=$1

  case "$(platform)" in
    darwin)
      printf '%s/Library/Application Support/Antigravity\n' "$profile_path"
      ;;
    linux)
      printf '%s/.config/Antigravity\n' "$profile_path"
      ;;
  esac
}

extensions_dir() {
  local profile_path=$1
  printf '%s/.antigravity/extensions\n' "$profile_path"
}

system_user_data_dir() {
  case "$(platform)" in
    darwin) printf '%s/Library/Application Support/Antigravity\n' "$HOME" ;;
    linux)  printf '%s/.config/Antigravity\n' "$HOME" ;;
  esac
}

system_extensions_dir() {
  printf '%s/.antigravity/extensions\n' "$HOME"
}

linux_launcher_dir() {
  printf '%s/.local/share/multigravity/launchers\n' "$HOME"
}

linux_launcher_path() {
  printf '%s/%s.sh\n' "$(linux_launcher_dir)" "$1"
}

linux_desktop_path() {
  printf '%s/.local/share/applications/multigravity-%s.desktop\n' "$HOME" "$1"
}

mac_shortcut_path() {
  printf '%s/Applications/Multigravity %s.app\n' "$HOME" "$1"
}

validate_name() {
  local name=$1

  if [[ -z "$name" ]]; then
    abort "profile name required"
  fi

  if ! [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ ]]; then
    abort "profile name must start with alphanumeric and contain only letters, numbers, or hyphens"
  fi
}

command_or_path() {
  local candidate=$1

  if [ -z "$candidate" ]; then
    return 1
  fi

  if [ -d "$candidate" ] || [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  if command -v "$candidate" >/dev/null 2>&1; then
    command -v "$candidate"
    return 0
  fi

  return 1
}

find_app() {
  local override candidate

  override="${MULTIGRAVITY_APP:-${AGY_APP-}}"
  if [ -n "$override" ] && command_or_path "$override" >/dev/null 2>&1; then
    command_or_path "$override"
    return 0
  fi

  case "$(platform)" in
    darwin)
      for candidate in \
        "/Applications/Antigravity.app" \
        "$HOME/Applications/Antigravity.app" \
        "/Applications/Agy.app" \
        "$HOME/Applications/Agy.app" \
        "antigravity" \
        "agy" \
        "/usr/local/bin/agy" \
        "$HOME/.local/bin/agy"
      do
        if [ -d "$candidate" ] || command_or_path "$candidate" >/dev/null 2>&1; then
          command_or_path "$candidate"
          return 0
        fi
      done
      ;;
    linux)
      for candidate in \
        "antigravity" \
        "agy" \
        "$HOME/apps/antigravity/antigravity" \
        "$HOME/apps/antigravity/bin/antigravity" \
        "$HOME/apps/agy/agy" \
        "$HOME/apps/agy/bin/agy" \
        "$HOME/.local/share/antigravity/antigravity" \
        "/opt/antigravity/antigravity" \
        "/opt/antigravity/bin/antigravity" \
        "/opt/agy/agy" \
        "/opt/agy/bin/agy" \
        "/usr/share/antigravity/antigravity" \
        "/usr/bin/antigravity" \
        "/usr/local/bin/antigravity" \
        "$HOME/.local/bin/antigravity" \
        "/usr/bin/agy" \
        "/usr/local/bin/agy" \
        "$HOME/.local/bin/agy" \
        "$HOME/Applications/Antigravity.AppImage"
      do
        if command_or_path "$candidate" >/dev/null 2>&1; then
          command_or_path "$candidate"
          return 0
        fi
      done
      ;;
  esac

  return 1
}

require_app() {
  local app

  if ! app="$(find_app)"; then
    case "$(platform)" in
      darwin)
        abort "Antigravity.app (or 'agy') was not found. Install Antigravity or set MULTIGRAVITY_APP to the app bundle path."
        ;;
      linux)
        abort "Antigravity (or 'agy') was not found. Install the Linux app so 'antigravity' or 'agy' is on PATH, or set MULTIGRAVITY_APP to the executable path."
        ;;
    esac
  fi

  printf '%s\n' "$app"
}

link_dev_dotfiles() {
  local profile_path=$1

  if [ -f "$profile_path/.isolated_dotfiles" ]; then
    return 0
  fi

  local user_home="${REAL_HOME:-$HOME}"

  # Link .gitconfig so user identity and preferences work in the integrated terminal
  if [ -f "$user_home/.gitconfig" ] && [ ! -e "$profile_path/.gitconfig" ]; then
    ln -s "$user_home/.gitconfig" "$profile_path/.gitconfig"
  fi

  # Link .ssh so git operations and remote access work in the integrated terminal
  if [ -d "$user_home/.ssh" ] && [ ! -e "$profile_path/.ssh" ]; then
    ln -s "$user_home/.ssh" "$profile_path/.ssh"
  fi

  # Link .gnupg for commit signing if present
  if [ -d "$user_home/.gnupg" ] && [ ! -e "$profile_path/.gnupg" ]; then
    ln -s "$user_home/.gnupg" "$profile_path/.gnupg"
  fi
}

link_mcp_config() {
  local profile_path=$1

  if [ -f "$profile_path/.isolated_mcp" ]; then
    return 0
  fi

  local user_home="${REAL_HOME:-$HOME}"
  local host_mcp_config="$user_home/.gemini/config/mcp_config.json"
  local target_config_dir="$profile_path/.gemini/config"
  local target_mcp_config="$target_config_dir/mcp_config.json"

  # 1. Link mcp_config.json
  if [ -f "$host_mcp_config" ] && [ ! -e "$target_mcp_config" ]; then
    mkdir -p "$target_config_dir"
    ln -s "$host_mcp_config" "$target_mcp_config"
  fi

  # 2. Link schemas directory ~/.gemini/antigravity/mcp
  local host_mcp_schemas="$user_home/.gemini/antigravity/mcp"
  local target_antigravity_dir="$profile_path/.gemini/antigravity"
  local target_mcp_schemas="$target_antigravity_dir/mcp"

  if [ -d "$host_mcp_schemas" ] && [ ! -e "$target_mcp_schemas" ]; then
    mkdir -p "$target_antigravity_dir"
    ln -s "$host_mcp_schemas" "$target_mcp_schemas"
  fi
}

mcp_cmd() {
  local action="${1-}" profile="${2-}"
  [ -n "$action" ] && [ -n "$profile" ] || abort "usage: multigravity mcp <status|share|isolate> <profile>"
  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  [ -d "$profile_path" ] || abort "profile '$profile' does not exist"

  local user_home="${REAL_HOME:-$HOME}"
  local host_mcp_config="$user_home/.gemini/config/mcp_config.json"
  local target_mcp_config="$profile_path/.gemini/config/mcp_config.json"
  local target_mcp_schemas="$profile_path/.gemini/antigravity/mcp"
  local host_mcp_schemas="$user_home/.gemini/antigravity/mcp"

  case "$action" in
    status)
      if [ -f "$profile_path/.isolated_mcp" ]; then
        print_info "Profile '$profile' has isolated MCP servers (--isolated-mcp active)."
      elif [ -L "$target_mcp_config" ]; then
        local target
        target="$(readlink "$target_mcp_config" 2>/dev/null || true)"
        print_info "Profile '$profile' shares host MCP servers -> $target"
      elif [ -f "$target_mcp_config" ]; then
        print_info "Profile '$profile' has a standalone local mcp_config.json."
      else
        print_info "Profile '$profile' has no MCP servers configured."
      fi
      ;;
    share)
      rm -f "$profile_path/.isolated_mcp"
      if [ -L "$target_mcp_config" ]; then
        print_info "Profile '$profile' is already sharing host MCP servers."
      else
        if [ -f "$target_mcp_config" ]; then
          mv "$target_mcp_config" "$target_mcp_config.bak"
          print_info "Backed up existing mcp_config.json to mcp_config.json.bak"
        fi
        link_mcp_config "$profile_path"
        print_info "Profile '$profile' is now sharing host MCP servers."
      fi
      ;;
    isolate)
      touch "$profile_path/.isolated_mcp"
      if [ -L "$target_mcp_config" ]; then
        rm -f "$target_mcp_config"
        if [ -f "$host_mcp_config" ]; then
          cp "$host_mcp_config" "$target_mcp_config"
          print_info "Copied host MCP config to standalone file for '$profile'."
        fi
      fi
      if [ -L "$target_mcp_schemas" ]; then
        rm -f "$target_mcp_schemas"
        if [ -d "$host_mcp_schemas" ]; then
          cp -r "$host_mcp_schemas" "$target_mcp_schemas"
        fi
      fi
      print_info "Profile '$profile' is now isolated from host MCP updates."
      ;;
    *)
      abort "usage: multigravity mcp <status|share|isolate> <profile>"
      ;;
  esac
}

link_skills_config() {
  local profile_path=$1

  if [ -f "$profile_path/.isolated_skills" ]; then
    return 0
  fi

  local user_home="${REAL_HOME:-$HOME}"
  local target_config_dir="$profile_path/.gemini/config"

  # 1. Link skills directory ~/.gemini/config/skills
  local host_skills="$user_home/.gemini/config/skills"
  local target_skills="$target_config_dir/skills"

  if [ -d "$host_skills" ] && [ ! -e "$target_skills" ]; then
    mkdir -p "$target_config_dir"
    ln -s "$host_skills" "$target_skills"
  fi

  # 2. Link plugins directory ~/.gemini/config/plugins
  local host_plugins="$user_home/.gemini/config/plugins"
  local target_plugins="$target_config_dir/plugins"

  if [ -d "$host_plugins" ] && [ ! -e "$target_plugins" ]; then
    mkdir -p "$target_config_dir"
    ln -s "$host_plugins" "$target_plugins"
  fi
}

skills_cmd() {
  local action="${1-}" profile="${2-}"
  [ -n "$action" ] && [ -n "$profile" ] || abort "usage: multigravity skills <status|share|isolate> <profile>"
  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  [ -d "$profile_path" ] || abort "profile '$profile' does not exist"

  local user_home="${REAL_HOME:-$HOME}"
  local host_skills="$user_home/.gemini/config/skills"
  local host_plugins="$user_home/.gemini/config/plugins"
  local target_skills="$profile_path/.gemini/config/skills"
  local target_plugins="$profile_path/.gemini/config/plugins"

  case "$action" in
    status)
      if [ -f "$profile_path/.isolated_skills" ]; then
        print_info "Profile '$profile' has isolated skills/plugins (--isolated-skills active)."
      elif [ -L "$target_skills" ] || [ -L "$target_plugins" ]; then
        local s_target p_target
        s_target="$(readlink "$target_skills" 2>/dev/null || echo "(none)")"
        p_target="$(readlink "$target_plugins" 2>/dev/null || echo "(none)")"
        print_info "Profile '$profile' shares host skills -> $s_target (plugins -> $p_target)"
      elif [ -d "$target_skills" ] || [ -d "$target_plugins" ]; then
        print_info "Profile '$profile' has standalone local skills/plugins."
      else
        print_info "Profile '$profile' has no custom skills or plugins configured."
      fi
      ;;
    share)
      rm -f "$profile_path/.isolated_skills"
      if [ -L "$target_skills" ] && [ -L "$target_plugins" ]; then
        print_info "Profile '$profile' is already sharing host skills and plugins."
      else
        if [ -d "$target_skills" ] && [ ! -L "$target_skills" ]; then
          mv "$target_skills" "$target_skills.bak"
          print_info "Backed up existing skills directory to skills.bak"
        fi
        if [ -d "$target_plugins" ] && [ ! -L "$target_plugins" ]; then
          mv "$target_plugins" "$target_plugins.bak"
          print_info "Backed up existing plugins directory to plugins.bak"
        fi
        link_skills_config "$profile_path"
        print_info "Profile '$profile' is now sharing host skills and plugins."
      fi
      ;;
    isolate)
      touch "$profile_path/.isolated_skills"
      if [ -L "$target_skills" ]; then
        rm -f "$target_skills"
        if [ -d "$host_skills" ]; then
          cp -r "$host_skills" "$target_skills"
          print_info "Copied host skills to standalone directory for '$profile'."
        fi
      fi
      if [ -L "$target_plugins" ]; then
        rm -f "$target_plugins"
        if [ -d "$host_plugins" ]; then
          cp -r "$host_plugins" "$target_plugins"
          print_info "Copied host plugins to standalone directory for '$profile'."
        fi
      fi
      print_info "Profile '$profile' is now isolated from host skills and plugins updates."
      ;;
    *)
      abort "usage: multigravity skills <status|share|isolate> <profile>"
      ;;
  esac
}

resolve_profile_color() {
  local input
  input="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"

  case "$input" in
    blue)                printf '%s %s\n' "#1e40af" "#172554" ;;
    navy)                printf '%s %s\n' "#1e3a8a" "#0f172a" ;;
    green)               printf '%s %s\n' "#166534" "#14532d" ;;
    emerald)             printf '%s %s\n' "#065f46" "#064e3b" ;;
    teal)                printf '%s %s\n' "#115e59" "#134e4a" ;;
    cyan)                printf '%s %s\n' "#155e75" "#164e63" ;;
    red)                 printf '%s %s\n' "#991b1b" "#7f1d1d" ;;
    rose)                printf '%s %s\n' "#9f1239" "#881337" ;;
    purple)              printf '%s %s\n' "#6b21a8" "#581c87" ;;
    violet)              printf '%s %s\n' "#5b21b6" "#4c1d95" ;;
    indigo)              printf '%s %s\n' "#3730a3" "#312e81" ;;
    pink)                printf '%s %s\n' "#9d174d" "#831843" ;;
    orange)              printf '%s %s\n' "#9a3412" "#7c2d12" ;;
    amber | yellow)      printf '%s %s\n' "#854d0e" "#713f12" ;;
    slate | gray | grey) printf '%s %s\n' "#334155" "#1e293b" ;;
    *)
      local clean_hex="${input#"#"}"
      if [[ "$clean_hex" =~ ^[0-9a-fA-F]{6}$ ]]; then
        printf '#%s #%s\n' "$clean_hex" "$clean_hex"
      else
        return 1
      fi
      ;;
  esac
}

apply_profile_color() {
  local profile_path=$1
  local color_arg=$2
  local clear_mode=false
  local primary="" secondary=""

  if [ "$color_arg" = "--clear" ]; then
    clear_mode=true
  else
    local resolved
    if ! resolved="$(resolve_profile_color "$color_arg")"; then
      abort "invalid color '$color_arg'. Use a recognized name (blue, green, red, purple, orange, cyan, pink, emerald, indigo, slate) or hex '#RRGGBB'."
    fi
    read -r primary secondary <<< "$resolved"
  fi

  local user_dir
  user_dir="$(user_data_dir "$profile_path")/User"
  mkdir -p "$user_dir"

  local settings_file="$user_dir/settings.json"

  # If settings.json is a symlink (e.g. in shared profile), uncouple it safely
  if [ -L "$settings_file" ]; then
    local tmp_copy
    tmp_copy="$(mktemp)"
    cp -L "$settings_file" "$tmp_copy" 2>/dev/null || echo "{}" > "$tmp_copy"
    rm -f "$settings_file"
    mv "$tmp_copy" "$settings_file"
  fi

  if command -v python3 >/dev/null 2>&1; then
    python3 - "$settings_file" "$primary" "$secondary" "$clear_mode" <<'PYEOF'
import sys, json, os

path, primary, secondary, clear = sys.argv[1], sys.argv[2], sys.argv[3], (sys.argv[4] == "true")
data = {}
if os.path.exists(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception:
        data = {}

if clear:
    if "workbench.colorCustomizations" in data:
        for k in [
            "titleBar.activeBackground", "titleBar.activeForeground",
            "titleBar.inactiveBackground", "titleBar.inactiveForeground",
            "activityBar.background", "activityBar.foreground",
            "activityBar.inactiveForeground", "statusBar.background",
            "statusBar.foreground"
        ]:
            data["workbench.colorCustomizations"].pop(k, None)
        if not data["workbench.colorCustomizations"]:
            del data["workbench.colorCustomizations"]
else:
    colors = data.setdefault("workbench.colorCustomizations", {})
    colors.update({
        "titleBar.activeBackground": primary,
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": secondary,
        "titleBar.inactiveForeground": "#d1d5db",
        "activityBar.background": secondary,
        "activityBar.foreground": "#ffffff",
        "activityBar.inactiveForeground": "#9ca3af",
        "statusBar.background": primary,
        "statusBar.foreground": "#ffffff"
    })

with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
    f.write("\n")
PYEOF
  else
    if [ "$clear_mode" != true ]; then
      cat <<EOF > "$settings_file"
{
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "$primary",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "$secondary",
    "titleBar.inactiveForeground": "#d1d5db",
    "activityBar.background": "$secondary",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#9ca3af",
    "statusBar.background": "$primary",
    "statusBar.foreground": "#ffffff"
  }
}
EOF
    fi
  fi
}

profile_color_cmd() {
  local profile="${1-}"
  local color_arg="${2-}"

  if [ -z "$profile" ]; then
    abort "usage: multigravity color <profile> [color|--clear]"
  fi

  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  if [ ! -d "$profile_path" ]; then
    abort "profile '$profile' does not exist"
  fi

  if [ -z "$color_arg" ]; then
    local settings_file="$(user_data_dir "$profile_path")/User/settings.json"
    if [ -f "$settings_file" ] && command -v python3 >/dev/null 2>&1; then
      local current_color
      current_color=$(python3 - "$settings_file" <<'PYEOF'
import sys, json, os
try:
    with open(sys.argv[1], "r", encoding="utf-8") as f:
        data = json.load(f)
    print(data.get("workbench.colorCustomizations", {}).get("titleBar.activeBackground", ""))
except Exception:
    pass
PYEOF
)
      if [ -n "$current_color" ]; then
        print_info "Profile '$profile' color: $current_color"
        return 0
      fi
    fi
    print_info "Profile '$profile' has no custom color set."
    return 0
  fi

  if [ "$color_arg" = "--clear" ]; then
    apply_profile_color "$profile_path" "--clear"
    print_info "Cleared color customizations for profile '$profile'."
  else
    apply_profile_color "$profile_path" "$color_arg"
    print_info "Set theme color for profile '$profile' to $color_arg."
  fi
}

create_profile_layout() {
  local profile_path=$1

  mkdir -p "$profile_path"
  mkdir -p "$(extensions_dir "$profile_path")"

  case "$(platform)" in
    darwin)
      mkdir -p "$profile_path/Library/Application Support"

      if [ ! -e "$profile_path/Library/Keychains" ] && [ -d "$HOME/Library/Keychains" ]; then
        ln -s "$HOME/Library/Keychains" "$profile_path/Library/Keychains"
      fi
      ;;
    linux)
      mkdir -p \
        "$profile_path/.config/Antigravity" \
        "$profile_path/.cache" \
        "$profile_path/.local/share" \
        "$profile_path/.local/state"
      ;;
  esac

  link_dev_dotfiles "$profile_path"
  link_mcp_config "$profile_path"
  link_skills_config "$profile_path"
}

create_shared_layout() {
  local profile_path=$1
  local sys_data sys_ext data_dir ext_dir

  sys_data="$(system_user_data_dir)"
  sys_ext="$(system_extensions_dir)"

  mkdir -p "$profile_path"
  touch "$profile_path/.shared"

  # Isolated user-data dir so accounts stay separate
  data_dir="$(user_data_dir "$profile_path")"
  mkdir -p "$data_dir/User"

  # Point settings/keybindings/snippets at the system install (read-only intent)
  if [ -d "$sys_data/User" ]; then
    local f
    for f in settings.json keybindings.json snippets; do
      if [ -e "$sys_data/User/$f" ] && [ ! -e "$data_dir/User/$f" ]; then
        ln -s "$sys_data/User/$f" "$data_dir/User/$f"
      fi
    done
  fi

  # Share the system extensions directory rather than an empty copy
  ext_dir="$(extensions_dir "$profile_path")"
  mkdir -p "$(dirname "$ext_dir")"
  if [ -d "$sys_ext" ]; then
    rm -rf "$ext_dir"
    ln -s "$sys_ext" "$ext_dir"
  else
    mkdir -p "$ext_dir"
  fi

  case "$(platform)" in
    darwin)
      mkdir -p "$profile_path/Library/Application Support"
      if [ ! -e "$profile_path/Library/Keychains" ] && [ -d "$HOME/Library/Keychains" ]; then
        ln -s "$HOME/Library/Keychains" "$profile_path/Library/Keychains"
      fi
      ;;
    linux)
      mkdir -p \
        "$profile_path/.cache" \
        "$profile_path/.local/share" \
        "$profile_path/.local/state"
      ;;
  esac

  link_dev_dotfiles "$profile_path"
  link_mcp_config "$profile_path"
  link_skills_config "$profile_path"
}

script_path() {
  local installed dir

  installed="$(command -v multigravity 2>/dev/null || true)"
  if [ -n "$installed" ]; then
    printf '%s\n' "$installed"
    return 0
  fi

  dir="$(cd "$(dirname "$0")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$0")"
}

shell_quote() {
  printf '%q' "$1"
}

desktop_quote() {
  local value=$1

  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//\$/\\$}
  value=${value//\`/\\\`}
  printf '"%s"' "$value"
}

create_shortcut_darwin() {
  local profile=$1
  local app_name="Multigravity $profile"
  local app_dir
  local run_script
  local launcher
  local icon_src

  app_dir="$(mac_shortcut_path "$profile")"
  run_script="$app_dir/Contents/MacOS/run"
  launcher="$(script_path)"
  icon_src="$(dirname "$launcher")/icon.icns"

  mkdir -p "$app_dir/Contents/MacOS"
  mkdir -p "$app_dir/Contents/Resources"

  cat <<EOF > "$run_script"
#!/usr/bin/env bash
export MULTIGRAVITY_HOME=$(shell_quote "$BASE")
exec $(shell_quote "$launcher") $(shell_quote "$profile") "\$@"
EOF

  chmod +x "$run_script"

  if [ -f "$icon_src" ]; then
    cp "$icon_src" "$app_dir/Contents/Resources/icon.icns"
  fi

  cat <<EOF > "$app_dir/Contents/Info.plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>run</string>
  <key>CFBundleIconFile</key>
  <string>icon</string>
  <key>CFBundleIdentifier</key>
  <string>com.multigravity.profile.$profile</string>
  <key>CFBundleName</key>
  <string>$app_name</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
</dict>
</plist>
EOF

  print_info "Shortcut created: $app_dir"
}

create_shortcut_linux() {
  local profile=$1
  local launcher_root
  local launcher_path
  local desktop_path
  local launcher

  launcher_root="$(linux_launcher_dir)"
  launcher_path="$(linux_launcher_path "$profile")"
  desktop_path="$(linux_desktop_path "$profile")"
  launcher="$(script_path)"

  mkdir -p "$launcher_root"
  mkdir -p "$(dirname "$desktop_path")"

  cat <<EOF > "$launcher_path"
#!/usr/bin/env sh
export MULTIGRAVITY_HOME=$(shell_quote "$BASE")
exec $(shell_quote "$launcher") $(shell_quote "$profile") "\$@"
EOF

  chmod +x "$launcher_path"

  cat <<EOF > "$desktop_path"
[Desktop Entry]
Version=1.0
Type=Application
Name=Multigravity $profile
Comment=Launch the $profile Antigravity profile
Exec=$(desktop_quote "$launcher_path") %F
Icon=antigravity
Terminal=false
StartupNotify=false
StartupWMClass=Antigravity
Categories=TextEditor;Development;IDE;
MimeType=application/x-antigravity-workspace;
EOF

  print_info "Shortcut created: $desktop_path"
}

create_shortcut() {
  case "$(platform)" in
    darwin)
      create_shortcut_darwin "$1"
      ;;
    linux)
      create_shortcut_linux "$1"
      ;;
  esac
}

remove_shortcut() {
  local profile=$1
  local target

  case "$(platform)" in
    darwin)
      target="$(mac_shortcut_path "$profile")"
      if [ -d "$target" ]; then
        rm -rf "$target"
        print_info "Removed shortcut: $target"
      fi
      ;;
    linux)
      target="$(linux_launcher_path "$profile")"
      if [ -f "$target" ]; then
        rm -f "$target"
        print_info "Removed shortcut: $target"
      fi

      target="$(linux_desktop_path "$profile")"
      if [ -f "$target" ]; then
        rm -f "$target"
        print_info "Removed shortcut: $target"
      fi
      ;;
  esac
}

launch_profile() {
  local profile=$1
  shift || true

  local profile_path
  local app
  local data_dir
  local ext_dir

  profile_path="$(profile_dir "$profile")"
  if [ ! -d "$profile_path" ]; then
    abort "profile '$profile' does not exist. Run: multigravity new $profile"
  fi

  create_profile_layout "$profile_path"

  app="$(require_app)"
  data_dir="$(user_data_dir "$profile_path")"
  ext_dir="$(extensions_dir "$profile_path")"

  print_info "Launching Antigravity profile '$profile'"

  case "$(platform)" in
    darwin)
      REAL_HOME="$REAL_HOME" HOME="$profile_path" open -n "$app" --args \
        --user-data-dir "$data_dir" \
        --extensions-dir "$ext_dir" \
        "$@"
      ;;
    linux)
      REAL_HOME="$REAL_HOME" \
      HOME="$profile_path" \
      XDG_CONFIG_HOME="$profile_path/.config" \
      XDG_CACHE_HOME="$profile_path/.cache" \
      XDG_DATA_HOME="$profile_path/.local/share" \
      XDG_STATE_HOME="$profile_path/.local/state" \
      "$app" \
        --user-data-dir "$data_dir" \
        --extensions-dir "$ext_dir" \
        "$@"
      ;;
  esac
}

list_profiles() {
  local entries=""
  local dir
  local raw=${1-}

  if [ "$raw" != "--raw" ]; then
    echo "Existing profiles:"
  fi

  if [ ! -d "$BASE" ]; then
    if [ "$raw" != "--raw" ]; then
      echo "(none)"
    fi
    return 0
  fi

  for dir in "$BASE"/*; do
    [ -d "$dir" ] || continue
    local n
    n="$(basename "$dir")"
    [ "$n" = ".templates" ] && continue
    entries="${entries}${n}"$'\n'
  done

  if [ -z "$entries" ]; then
    if [ "$raw" != "--raw" ]; then
      echo "(none)"
    fi
  else
    printf '%s' "$entries" | sort
  fi
}

new_profile() {
  local profile="" shared=false from_tpl="" isolated_dotfiles=false isolated_mcp=false isolated_skills=false color=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --shared)             shared=true ;;
      --from)               from_tpl="${2-}"; shift ;;
      --isolated-dotfiles)  isolated_dotfiles=true ;;
      --isolated-mcp)       isolated_mcp=true ;;
      --isolated-skills)    isolated_skills=true ;;
      --color)              color="${2-}"; shift ;;
      -*)                   abort "unknown option: $1" ;;
      *)                    profile="$1" ;;
    esac
    shift
  done

  validate_name "$profile"

  if [ -n "$color" ] && ! resolve_profile_color "$color" >/dev/null; then
    abort "invalid color '$color'. Use a recognized name (blue, green, red, purple, orange, cyan, pink, emerald, indigo, slate) or hex '#RRGGBB'."
  fi

  local profile_path
  profile_path="$(profile_dir "$profile")"
  if [ -d "$profile_path" ]; then
    abort "profile '$profile' already exists"
  fi

  mkdir -p "$BASE"
  mkdir -p "$profile_path"

  if [ "$isolated_dotfiles" = true ]; then
    touch "$profile_path/.isolated_dotfiles"
  fi
  if [ "$isolated_mcp" = true ]; then
    touch "$profile_path/.isolated_mcp"
  fi
  if [ "$isolated_skills" = true ]; then
    touch "$profile_path/.isolated_skills"
  fi

  if [ -n "$from_tpl" ]; then
    local tpl_path
    tpl_path="$(templates_dir)/$from_tpl"
    [ -d "$tpl_path" ] || abort "template '$from_tpl' not found. Run: multigravity template list"
    print_info "Creating profile '$profile' from template '$from_tpl'..."
    cp -R "$tpl_path"/* "$profile_path"/ 2>/dev/null || cp -R "$tpl_path"/. "$profile_path"/
    [ "$isolated_dotfiles" = false ] && link_dev_dotfiles "$profile_path"
    [ "$isolated_mcp" = false ] && link_mcp_config "$profile_path"
    [ "$isolated_skills" = false ] && link_skills_config "$profile_path"
  elif [ "$shared" = true ]; then
    create_shared_layout "$profile_path"
  else
    create_profile_layout "$profile_path"
  fi

  if [ -n "$color" ]; then
    apply_profile_color "$profile_path" "$color"
  fi

  print_info "Created profile '$profile'"
  create_shortcut "$profile"
}

get_profile_pids() {
  local profile=$1
  local profile_path data_dir
  profile_path="$(profile_dir "$profile")"
  data_dir="$(user_data_dir "$profile_path")"

  (ps -eo pid,ppid,args 2>/dev/null | grep -v grep | grep -F "$data_dir" | awk -v self="$$" -v parent="$PPID" '$1 != self && $1 != parent && $2 != self {print $1}') || true
}

is_profile_running() {
  local pids
  pids="$(get_profile_pids "$1")"
  [ -n "$pids" ]
}

stop_profile() {
  local profile="" force=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force | -f) force=true ;;
      -*)           abort "unknown option: $1" ;;
      *)            profile="$1" ;;
    esac
    shift
  done

  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  if [ ! -d "$profile_path" ]; then
    abort "profile '$profile' does not exist"
  fi

  local pids
  pids="$(get_profile_pids "$profile")"

  if [ -z "$pids" ]; then
    print_info "Profile '$profile' is not running."
    return 0
  fi

  print_info "Stopping profile '$profile'..."

  if [ "$force" = true ]; then
    kill -9 $pids 2>/dev/null || true
    print_info "Profile '$profile' forcefully stopped."
    return 0
  fi

  # Graceful SIGTERM
  kill $pids 2>/dev/null || true

  local waited=0
  while [ $waited -lt 15 ]; do
    sleep 0.2
    waited=$((waited + 1))
    pids="$(get_profile_pids "$profile")"
    if [ -z "$pids" ]; then
      print_info "Profile '$profile' stopped gracefully."
      return 0
    fi
  done

  print_info "Terminating remaining processes for profile '$profile'..."
  kill -9 $pids 2>/dev/null || true
  print_info "Profile '$profile' stopped."
}

restart_profile() {
  local profile="${1-}"
  shift || true

  validate_name "$profile"
  stop_profile "$profile"
  sleep 0.5
  launch_profile "$profile" "$@"
}

delete_profile() {
  local profile="" force=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force | -f) force=true ;;
      -*)           abort "unknown option: $1" ;;
      *)            profile="$1" ;;
    esac
    shift
  done

  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  if [ ! -d "$profile_path" ]; then
    abort "profile '$profile' does not exist"
  fi

  if is_profile_running "$profile"; then
    if [ "$force" = true ]; then
      print_info "Profile '$profile' is running. Stopping it first (--force)..."
      stop_profile "$profile" --force
    else
      abort "cannot delete profile '$profile' because it is currently running. Stop it first with: multigravity stop $profile (or pass --force)"
    fi
  fi

  local confirm
  if [ "$force" = true ]; then
    confirm="y"
  else
    read -r -p "Delete profile '$profile' and all its data? [y/N] " confirm
  fi
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    rm -rf "$profile_path"
    remove_shortcut "$profile"
    print_info "Deleted profile '$profile'"
  else
    print_info "Aborted."
  fi
}

rename_profile() {
  local old=$1
  local new=$2

  validate_name "$old"
  validate_name "$new"

  local old_path
  local new_path

  old_path="$(profile_dir "$old")"
  new_path="$(profile_dir "$new")"

  if [ ! -d "$old_path" ]; then
    abort "profile '$old' does not exist"
  fi
  if [ -d "$new_path" ]; then
    abort "profile '$new' already exists"
  fi

  if is_profile_running "$old"; then
    abort "cannot rename profile '$old' because it is currently running. Stop it first with: multigravity stop $old"
  fi

  mv "$old_path" "$new_path"
  remove_shortcut "$old"
  create_shortcut "$new"

  print_info "Renamed profile '$old' to '$new'"
}

clone_profile() {
  local src=$1
  local dest=$2
  local src_path
  local dest_path

  validate_name "$src"
  validate_name "$dest"

  src_path="$(profile_dir "$src")"
  dest_path="$(profile_dir "$dest")"

  if [ ! -d "$src_path" ]; then
    abort "source profile '$src' does not exist"
  fi
  if [ -d "$dest_path" ]; then
    abort "destination profile '$dest' already exists"
  fi

  print_info "Cloning profile '$src' to '$dest'..."
  cp -R "$src_path" "$dest_path"
  create_shortcut "$dest"

  print_info "Successfully cloned '$src' to '$dest'"
}

clean_single_profile() {
  local name=$1
  local p_dir
  p_dir="$(profile_dir "$name")"
  local data_dir
  data_dir="$(user_data_dir "$p_dir")"

  local before after
  before="$(du -sh "$p_dir" 2>/dev/null | cut -f1)"

  rm -rf \
    "$data_dir/Cache" \
    "$data_dir/Code Cache" \
    "$data_dir/GPUCache" \
    "$data_dir/DawnGraphiteCache" \
    "$data_dir/DawnWebGPUCache" \
    "$data_dir/Crashpad" \
    "$data_dir/logs" \
    "$data_dir/CachedData" \
    "$data_dir/CachedExtensions" \
    "$data_dir/CachedExtensionVSIXs" \
    "$data_dir/Service Worker/CacheStorage" \
    "$data_dir/Service Worker/ScriptCache" \
    "$data_dir/webrtc_event_logs" \
    "$p_dir/.cache" \
    "$p_dir/.gemini/antigravity/crashes" \
    "$p_dir/.npm/_cacache" \
    "$p_dir/Library/Caches"

  mkdir -p "$p_dir/.cache" 2>/dev/null || true

  after="$(du -sh "$p_dir" 2>/dev/null | cut -f1)"
  print_info "Cleaned cache for '$name' ($before -> $after)"
}

clean_profile() {
  local target="${1-}"
  [ -n "$target" ] || abort "usage: multigravity clean <profile|--all>"

  if [ "$target" = "--all" ]; then
    if [ ! -d "$BASE" ]; then
      print_info "No profiles found."
      return 0
    fi
    local count=0
    for dir in "$BASE"/*; do
      [ -d "$dir" ] || continue
      local name
      name=$(basename "$dir")
      [ "$name" = ".templates" ] && continue

      if is_profile_running "$name"; then
        print_warn "Skipping '$name': profile is currently running"
        continue
      fi
      clean_single_profile "$name"
      count=$((count + 1))
    done
    print_info "Cleaned $count profile(s)."
  else
    validate_name "$target"
    local p_dir
    p_dir="$(profile_dir "$target")"
    [ -d "$p_dir" ] || abort "profile '$target' does not exist"

    if is_profile_running "$target"; then
      abort "profile '$target' is currently running — stop it first (multigravity stop $target)"
    fi

    clean_single_profile "$target"
  fi
}

doctor_cli() {
  local errors=0
  local warnings=0

  print_info "Checking multigravity environment..."

  # 1. Platform Check
  if platform &>/dev/null; then
    echo "  [✓] Platform: $(platform)"
  else
    echo "  [✗] Platform: Unknown"
    errors=$((errors + 1))
  fi

  # 2. Antigravity / Agy Installation
  if app=$(find_app); then
    echo "  [✓] Antigravity / Agy: Found at $app"
  else
    echo "  [✗] Antigravity / Agy: Not found. Ensure it is installed or set MULTIGRAVITY_APP or AGY_APP."
    errors=$((errors + 1))
  fi

  # 3. Path Check
  local installed
  installed="$(command -v multigravity 2>/dev/null || true)"
  if [ -n "$installed" ]; then
    echo "  [✓] Global Binary: $installed"
  else
    echo "  [!] Global Binary: Not found in PATH. Run install script or update PATH."
    warnings=$((warnings + 1))
  fi

  # 4. Icon Check (macOS)
  if [ "$(platform)" = "darwin" ]; then
    local icon_path
    icon_path="$(dirname "$(script_path)")/icon.icns"
    if [ -f "$icon_path" ]; then
      echo "  [✓] Application Icon: Found"
    else
      echo "  [!] Application Icon: Missing ($icon_path). Shortcuts will have default icons."
      warnings=$((warnings + 1))
    fi
  fi

  # 5. Base Directory
  if [ -d "$BASE" ]; then
    if [ -w "$BASE" ]; then
      echo "  [✓] Profile storage: $BASE (writable)"
    else
      echo "  [✗] Profile storage: $BASE (NOT writable)"
      errors=$((errors + 1))
    fi
  else
    echo "  [!] Profile storage: $BASE (Not yet created)"
  fi

  echo ""
  if [ $errors -eq 0 ]; then
    if [ $warnings -eq 0 ]; then
      print_info "✓ Your environment looks perfect!"
    else
      print_info "Found $warnings warning(s). Multigravity should still work, but some features might be degraded."
    fi
  else
    print_info "✗ Found $errors error(s) and $warnings warning(s). Please fix the errors above."
  fi
}

profile_stats() {
  if [ ! -d "$BASE" ]; then
    print_info "No profiles found."
    return 0
  fi

  print_info "Profile Storage Usage:"
  printf "%-20s %-10s %-10s\n" "PROFILE" "SIZE" "EXTENSIONS"
  printf "%-20s %-10s %-10s\n" "-------" "----" "----------"

  local dir
  for dir in "$BASE"/*; do
    [ -d "$dir" ] || continue
    local name
    name=$(basename "$dir")
    [ "$name" = ".templates" ] && continue

    local size
    size=$(du -sh "$dir" | cut -f1)

    local ext_count
    ext_count=$(ls -1 "$(extensions_dir "$dir")" 2>/dev/null | wc -l | xargs)
    [ -z "$ext_count" ] && ext_count=0

    printf "%-20s %-10s %-10s\n" "$name" "$size" "$ext_count"
  done

  echo ""
  local total
  total=$(du -sh "$BASE" | cut -f1)
  print_info "Total usage: $total"
}

status_profiles() {
  if [ ! -d "$BASE" ]; then
    print_info "No profiles found."
    return 0
  fi

  printf "%-18s %-10s %-12s %-20s %s\n" "PROFILE" "RUNNING" "TYPE" "LAST USED" "SIZE"
  printf "%-18s %-10s %-12s %-20s %s\n" "-------" "-------" "----" "---------" "----"

  local dir
  for dir in "$BASE"/*; do
    [ -d "$dir" ] || continue
    local name
    name="$(basename "$dir")"
    [ "$name" = ".templates" ] && continue

    local running="no"
    if is_profile_running "$name"; then
      running="yes"
    fi

    local ptype="full"
    [ -f "$dir/.shared" ] && ptype="shared"

    local last_used
    case "$(platform)" in
      darwin) last_used=$(stat -f "%Sm" -t "%Y-%m-%d %H:%M" "$dir" 2>/dev/null || echo "unknown") ;;
      linux)  last_used=$(stat -c "%y" "$dir" 2>/dev/null | cut -d'.' -f1 || echo "unknown") ;;
    esac

    local size
    size="$(du -sh "$dir" 2>/dev/null | cut -f1)"

    if [ "$running" = "yes" ]; then
      printf "%-18s \033[32m%-10s\033[0m %-12s %-20s %s\n" "$name" "$running" "$ptype" "$last_used" "$size"
    else
      printf "%-18s %-10s %-12s %-20s %s\n" "$name" "$running" "$ptype" "$last_used" "$size"
    fi
  done
}

template_cmd() {
  local subcmd="${1-}"
  shift || true

  case "$subcmd" in
    save)
      local profile="${1-}" tpl_name="${2-}"
      validate_name "$profile"
      validate_name "$tpl_name"
      local src_path tpl_dir tpl_path
      src_path="$(profile_dir "$profile")"
      [ -d "$src_path" ] || abort "profile '$profile' does not exist"
      tpl_dir="$(templates_dir)"
      tpl_path="$tpl_dir/$tpl_name"
      [ -d "$tpl_path" ] && abort "template '$tpl_name' already exists"
      mkdir -p "$tpl_dir"
      print_info "Saving '$profile' as template '$tpl_name'..."
      cp -R "$src_path" "$tpl_path"
      rm -f "$tpl_path/.shared"
      print_info "Saved template '$tpl_name'"
      ;;
    list)
      local tpl_dir
      tpl_dir="$(templates_dir)"
      echo "Templates:"
      if [ ! -d "$tpl_dir" ]; then
        echo "  (none)"
        return 0
      fi
      local any=false
      for d in "$tpl_dir"/*; do
        [ -d "$d" ] || continue
        any=true
        printf "  %-20s %s\n" "$(basename "$d")" "$(du -sh "$d" 2>/dev/null | cut -f1)"
      done
      [ "$any" = false ] && echo "  (none)"
      ;;
    delete)
      local tpl_name="${1-}"
      validate_name "$tpl_name"
      local tpl_path
      tpl_path="$(templates_dir)/$tpl_name"
      [ -d "$tpl_path" ] || abort "template '$tpl_name' does not exist"
      rm -rf "$tpl_path"
      print_info "Deleted template '$tpl_name'"
      ;;
    *)
      abort "usage: multigravity template <save|list|delete>"
      ;;
  esac
}

export_profile() {
  local profile="" out="" include_cache=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --include-cache)
        include_cache=true
        ;;
      -*)
        abort "unknown option: $1"
        ;;
      *)
        if [ -z "$profile" ]; then
          profile="$1"
        elif [ -z "$out" ]; then
          out="$1"
        else
          abort "unexpected argument: $1"
        fi
        ;;
    esac
    shift
  done

  [ -n "$profile" ] || abort "usage: multigravity export <name> [path] [--include-cache]"
  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  [ -d "$profile_path" ] || abort "profile '$profile' does not exist"

  [ -z "$out" ] && out="./${profile}.tar.gz"

  print_info "Exporting '$profile' to $out ..."
  if [ "$include_cache" = true ]; then
    tar -czf "$out" -C "$BASE" "$profile"
  else
    tar -czf "$out" \
      --exclude="$profile/.cache" \
      --exclude="$profile/.cache/*" \
      --exclude="*/Antigravity/Cache" \
      --exclude="*/Antigravity/Cache/*" \
      --exclude="*/Antigravity/Code Cache" \
      --exclude="*/Antigravity/Code Cache/*" \
      --exclude="*/Antigravity/GPUCache" \
      --exclude="*/Antigravity/GPUCache/*" \
      --exclude="*/Antigravity/DawnGraphiteCache" \
      --exclude="*/Antigravity/DawnGraphiteCache/*" \
      --exclude="*/Antigravity/DawnWebGPUCache" \
      --exclude="*/Antigravity/DawnWebGPUCache/*" \
      --exclude="*/Antigravity/Crashpad" \
      --exclude="*/Antigravity/Crashpad/*" \
      --exclude="*/Antigravity/logs" \
      --exclude="*/Antigravity/logs/*" \
      --exclude="*/Antigravity/CachedData" \
      --exclude="*/Antigravity/CachedData/*" \
      --exclude="*/Antigravity/CachedExtensions" \
      --exclude="*/Antigravity/CachedExtensions/*" \
      --exclude="*/Antigravity/CachedExtensionVSIXs" \
      --exclude="*/Antigravity/CachedExtensionVSIXs/*" \
      --exclude="*/Antigravity/Service Worker/CacheStorage" \
      --exclude="*/Antigravity/Service Worker/CacheStorage/*" \
      --exclude="*/Antigravity/Service Worker/ScriptCache" \
      --exclude="*/Antigravity/Service Worker/ScriptCache/*" \
      --exclude="*/Antigravity/webrtc_event_logs" \
      --exclude="*/Antigravity/webrtc_event_logs/*" \
      --exclude="$profile/.gemini/antigravity/crashes" \
      --exclude="$profile/.gemini/antigravity/crashes/*" \
      --exclude="$profile/.npm/_cacache" \
      --exclude="$profile/.npm/_cacache/*" \
      --exclude="$profile/Library/Caches" \
      --exclude="$profile/Library/Caches/*" \
      -C "$BASE" "$profile"
  fi
  print_info "Done."
}

import_profile() {
  local archive="${1-}" profile="${2-}"

  [ -n "$archive" ] || abort "usage: multigravity import <archive.tar.gz> [name]"
  [ -f "$archive" ]  || abort "file not found: $archive"

  if [ -z "$profile" ]; then
    profile="$(tar -tzf "$archive" 2>/dev/null | head -1 | cut -d'/' -f1)"
    [ -n "$profile" ] || abort "cannot infer profile name from archive — pass a name explicitly"
  fi

  validate_name "$profile"

  local dest
  dest="$(profile_dir "$profile")"
  [ -d "$dest" ] && abort "profile '$profile' already exists — choose a different name or delete it first"

  mkdir -p "$BASE"
  print_info "Importing as '$profile'..."

  local top_dir
  top_dir="$(tar -tzf "$archive" 2>/dev/null | head -1 | cut -d'/' -f1)"
  tar -xzf "$archive" -C "$BASE"
  if [ -n "$top_dir" ] && [ "$top_dir" != "$profile" ] && [ -d "$BASE/$top_dir" ]; then
    mv "$BASE/$top_dir" "$dest"
  fi

  create_shortcut "$profile"
  print_info "Imported profile '$profile'"
}

ai_list() {
  local profile="${1-}"
  [ -n "$profile" ] || abort "usage: multigravity ai list <profile>"
  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  [ -d "$profile_path" ] || abort "profile '$profile' does not exist"

  local gemini_dir="$profile_path/.gemini/antigravity"
  if [ ! -d "$gemini_dir/conversations" ] && [ ! -d "$gemini_dir/brain" ]; then
    print_info "Profile '$profile' has no saved AI chats."
    return 0
  fi

  print_info "AI Conversations in profile '$profile':"
  printf "%-38s %-32s %s\n" "CONVERSATION ID" "TITLE" "ARTIFACTS"
  printf "%-38s %-32s %s\n" "---------------" "-----" "---------"

  local count=0
  local db_file
  for db_file in "$gemini_dir"/conversations/*.db; do
    [ -f "$db_file" ] || continue
    local uuid
    uuid="$(basename "$db_file" .db)"

    local title=""
    local annot_file="$gemini_dir/annotations/$uuid.pbtxt"
    if [ -f "$annot_file" ]; then
      title=$(sed -n 's/.*title:[[:space:]]*"\([^"]*\)".*/\1/p' "$annot_file" 2>/dev/null || true)
    fi
    [ -z "$title" ] && title="(untitled conversation)"
    if [ ${#title} -gt 30 ]; then
      title="${title:0:27}..."
    fi

    local art_count="none"
    local brain_dir="$gemini_dir/brain/$uuid"
    if [ -d "$brain_dir" ]; then
      local n
      n=$(find "$brain_dir" -maxdepth 1 -name "*.md" 2>/dev/null | wc -l | xargs)
      [ -n "$n" ] && [ "$n" -gt 0 ] && art_count="$n file(s)"
    fi

    printf "%-38s %-32s %s\n" "$uuid" "$title" "$art_count"
    count=$((count + 1))
  done

  if [ "$count" -eq 0 ]; then
    print_info "No conversations found."
  else
    echo ""
    print_info "Total conversations: $count"
  fi
}

ai_export() {
  local profile="${1-}" out="${2-}"
  [ -n "$profile" ] || abort "usage: multigravity ai export <profile> [path.tar.gz]"
  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  [ -d "$profile_path" ] || abort "profile '$profile' does not exist"

  if is_profile_running "$profile"; then
    abort "profile '$profile' is currently running — stop it first to ensure SQLite database flush (multigravity stop $profile)"
  fi

  local gemini_dir="$profile_path/.gemini/antigravity"
  if [ ! -d "$gemini_dir" ]; then
    abort "profile '$profile' has no AI data (.gemini/antigravity does not exist)"
  fi

  [ -z "$out" ] && out="./${profile}-ai-chats.tar.gz"

  local items=()
  local d
  for d in conversations brain annotations knowledge antigravity_state.pbtxt agyhub_summaries_proto.pb; do
    if [ -e "$gemini_dir/$d" ]; then
      items+=("$d")
    fi
  done

  if [ ${#items[@]} -eq 0 ]; then
    abort "no AI conversation or brain data found in profile '$profile'"
  fi

  print_info "Exporting AI chats from '$profile' to $out ..."
  tar -czf "$out" \
    --exclude="*token*" \
    --exclude="*oauth*" \
    --exclude="*auth*" \
    --exclude="*credential*" \
    --exclude="installation_id" \
    -C "$gemini_dir" "${items[@]}"

  local conv_count=0
  if [ -d "$gemini_dir/conversations" ]; then
    conv_count=$(find "$gemini_dir/conversations" -maxdepth 1 -name "*.db" 2>/dev/null | wc -l | xargs)
  fi

  print_info "Successfully exported $conv_count conversation(s) to $out (credentials sanitized)."
}

ai_import() {
  local archive="${1-}" profile="${2-}"
  [ -n "$archive" ] && [ -n "$profile" ] || abort "usage: multigravity ai import <archive.tar.gz> <profile>"
  [ -f "$archive" ] || abort "file not found: $archive"
  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  [ -d "$profile_path" ] || abort "profile '$profile' does not exist"

  if is_profile_running "$profile"; then
    abort "profile '$profile' is currently running — stop it first (multigravity stop $profile)"
  fi

  local target_gemini="$profile_path/.gemini/antigravity"
  mkdir -p "$target_gemini"

  print_info "Importing AI chats into '$profile'..."

  local extra_excludes=()
  if [ -f "$target_gemini/agyhub_summaries_proto.pb" ]; then
    extra_excludes+=(--exclude="agyhub_summaries_proto.pb")
  fi
  if [ -f "$target_gemini/antigravity_state.pbtxt" ]; then
    extra_excludes+=(--exclude="antigravity_state.pbtxt")
  fi

  tar -xzf "$archive" \
    --exclude="*token*" \
    --exclude="*oauth*" \
    --exclude="*auth*" \
    --exclude="*credential*" \
    --exclude="installation_id" \
    "${extra_excludes[@]}" \
    -C "$target_gemini"

  local conv_count=0
  if [ -d "$target_gemini/conversations" ]; then
    conv_count=$(find "$target_gemini/conversations" -maxdepth 1 -name "*.db" 2>/dev/null | wc -l | xargs)
  fi

  print_info "Successfully imported AI chats into profile '$profile' ($conv_count conversation(s) now available)."
}

ai_sync() {
  local src="${1-}" dest="${2-}"
  [ -n "$src" ] && [ -n "$dest" ] || abort "usage: multigravity ai sync <source_profile> <target_profile>"
  validate_name "$src"
  validate_name "$dest"

  [ "$src" != "$dest" ] || abort "source and target profiles cannot be the same"

  local src_path dest_path
  src_path="$(profile_dir "$src")"
  dest_path="$(profile_dir "$dest")"

  [ -d "$src_path" ] || abort "source profile '$src' does not exist"
  [ -d "$dest_path" ] || abort "target profile '$dest' does not exist"

  if is_profile_running "$src"; then
    abort "source profile '$src' is currently running — stop it first (multigravity stop $src)"
  fi
  if is_profile_running "$dest"; then
    abort "target profile '$dest' is currently running — stop it first (multigravity stop $dest)"
  fi

  local src_gemini="$src_path/.gemini/antigravity"
  local dest_gemini="$dest_path/.gemini/antigravity"

  [ -d "$src_gemini" ] || abort "source profile '$src' has no AI data (.gemini/antigravity does not exist)"

  mkdir -p "$dest_gemini/conversations" "$dest_gemini/annotations" "$dest_gemini/brain" "$dest_gemini/knowledge"

  print_info "Syncing AI conversations from '$src' to '$dest'..."
  local synced=0

  if [ -d "$src_gemini/conversations" ]; then
    local db_file
    for db_file in "$src_gemini/conversations"/*.db; do
      [ -f "$db_file" ] || continue
      local filename uuid
      filename="$(basename "$db_file")"
      uuid="${filename%.db}"

      if [ ! -f "$dest_gemini/conversations/$filename" ] || [ "$db_file" -nt "$dest_gemini/conversations/$filename" ]; then
        cp -f "$db_file" "$dest_gemini/conversations/$filename"

        if [ -f "$src_gemini/annotations/$uuid.pbtxt" ]; then
          cp -f "$src_gemini/annotations/$uuid.pbtxt" "$dest_gemini/annotations/$uuid.pbtxt"
        fi

        if [ -d "$src_gemini/brain/$uuid" ]; then
          mkdir -p "$dest_gemini/brain/$uuid"
          cp -rf "$src_gemini/brain/$uuid"/* "$dest_gemini/brain/$uuid/" 2>/dev/null || true
        fi

        synced=$((synced + 1))
      fi
    done
  fi

  if [ -d "$src_gemini/knowledge" ]; then
    local kfile
    for kfile in "$src_gemini/knowledge"/*; do
      [ -e "$kfile" ] || continue
      local kname
      kname="$(basename "$kfile")"
      case "$kname" in
        *token*|*oauth*|*auth*|*credential*) continue ;;
      esac
      if [ ! -e "$dest_gemini/knowledge/$kname" ] || [ "$kfile" -nt "$dest_gemini/knowledge/$kname" ]; then
        cp -rf "$kfile" "$dest_gemini/knowledge/" 2>/dev/null || true
      fi
    done
  fi

  if [ ! -f "$dest_gemini/agyhub_summaries_proto.pb" ] && [ -f "$src_gemini/agyhub_summaries_proto.pb" ]; then
    cp -f "$src_gemini/agyhub_summaries_proto.pb" "$dest_gemini/agyhub_summaries_proto.pb"
  fi

  local total_dest=0
  if [ -d "$dest_gemini/conversations" ]; then
    total_dest=$(find "$dest_gemini/conversations" -maxdepth 1 -name "*.db" 2>/dev/null | wc -l | xargs)
  fi

  print_info "Successfully synced $synced conversation(s) into '$dest' (total: $total_dest available)."
}

ai_cmd() {
  local sub="${1-}"
  shift || true

  case "$sub" in
    export)
      ai_export "$@"
      ;;
    import)
      ai_import "$@"
      ;;
    sync)
      ai_sync "$@"
      ;;
    list)
      ai_list "$@"
      ;;
    *)
      abort "usage: multigravity ai <export|import|sync|list> [args...]"
      ;;
  esac
}

update_cli() {
  local repo="${MULTIGRAVITY_REPO:-yegear1/multigravity-cli}"
  local branch="${MULTIGRAVITY_BRANCH:-main}"
  local script_url="https://raw.githubusercontent.com/$repo/$branch/multigravity"
  local target
  target="$(script_path)"

  if [ -z "$target" ]; then
    abort "could not determine script path for update"
  fi

  print_info "Updating multigravity from $script_url ..."
  if curl -fsSL "$script_url" -o "$target.tmp"; then
    mv "$target.tmp" "$target"
    chmod +x "$target"
    print_info "Successfully updated multigravity!"
  else
    rm -f "$target.tmp"
    abort "failed to download update"
  fi
}

version_cli() {
  echo "multigravity v$VERSION (fork: yegear1/multigravity-cli)"
}

help_completion() {
  local shell_name
  shell_name="$(basename "$SHELL")"

  echo "To enable autocompletion, add the following to your shell profile:"
  echo ""
  case "$shell_name" in
    zsh)
      echo "  # Add to ~/.zshrc"
      echo '  source <(multigravity completion zsh)'
      ;;
    bash)
      echo "  # Add to ~/.bashrc"
      echo '  source <(multigravity completion bash)'
      ;;
    *)
      echo "  # Your shell ($shell_name) is not natively supported for completion."
      ;;
  esac
  echo ""
  echo "Then restart your terminal or run: source ~/.$shell_name""rc"
}

generate_completion() {
  local shell_type=$1
  case "$shell_type" in
    zsh)
      cat <<'EOF'
#compdef multigravity
_multigravity() {
    local -a commands
    commands=(
        'new:Create a new profile'
        'color:View or change profile theme color'
        'stop:Stop a running profile'
        'restart:Restart a profile'
        'clean:Clean profile caches to free up disk space'
        'list:List existing profiles'
        'status:Show running state, type, and last-used time per profile'
        'rename:Rename a profile'
        'delete:Delete a profile'
        'clone:Clone an existing profile'
        'template:Manage profile templates (save, list, delete)'
        'export:Pack a profile into a tar.gz archive'
        'import:Restore a profile from a tar.gz archive'
        'ai:Manage AI chats and brains (export, import, list)'
        'mcp:Manage MCP server configuration (status, share, isolate)'
        'skills:Manage skills and plugins configuration (status, share, isolate)'
        'update:Update multigravity'
        'doctor:Run system diagnosis'
        'stats:Show profile storage usage'
        'completion:Setup shell completion'
        'version:Show multigravity version'
        'help:Show help'
    )
    local curcontext="$curcontext" state line
    _arguments -C '1: :->command' '*: :->args'
    case $state in
        command)
            _describe -t commands 'multigravity command' commands
            local -a profiles
            profiles=($(multigravity list --raw 2>/dev/null))
            (( ${#profiles} > 0 )) && _describe -t profiles 'profile' profiles
            ;;
        args)
            case $line[1] in
                clean)
                    local -a targets
                    targets=($(multigravity list --raw 2>/dev/null) '--all')
                    _describe -t targets 'target' targets
                    ;;
                ai)
                    local -a subcommands
                    subcommands=('export:Export AI conversations' 'import:Import AI conversations' 'sync:Synchronize AI conversations between two profiles' 'list:List AI conversations')
                    _describe -t subcommands 'subcommand' subcommands
                    ;;
                mcp)
                    local -a subcommands
                    subcommands=('status:Show MCP sharing status' 'share:Share host MCP servers' 'isolate:Isolate MCP servers locally')
                    _describe -t subcommands 'subcommand' subcommands
                    ;;
                skills)
                    local -a subcommands
                    subcommands=('status:Show skills/plugins sharing status' 'share:Share host skills and plugins' 'isolate:Isolate skills and plugins locally')
                    _describe -t subcommands 'subcommand' subcommands
                    ;;
                color|stop|restart|rename|delete|clone|help)
                    local -a profiles
                    profiles=($(multigravity list --raw 2>/dev/null))
                    (( ${#profiles} > 0 )) && _describe -t profiles 'profile' profiles
                    ;;
            esac
            ;;
    esac
}
_multigravity "$@"
EOF
      ;;
    bash)
      cat <<'EOF'
_multigravity_completions() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    opts="new color stop restart clean list status rename delete clone template export import ai mcp skills update doctor stats completion version help"

    if [[ ${COMP_CWORD} -eq 1 ]] ; then
        local profiles=$(multigravity list --raw 2>/dev/null)
        COMPREPLY=( $(compgen -W "${opts} ${profiles}" -- "${cur}") )
        return 0
    fi

    case "${prev}" in
        clean)
            local profiles=$(multigravity list --raw 2>/dev/null)
            COMPREPLY=( $(compgen -W "${profiles} --all" -- "${cur}") )
            return 0
            ;;
        ai)
            COMPREPLY=( $(compgen -W "export import sync list" -- "${cur}") )
            return 0
            ;;
        mcp)
            COMPREPLY=( $(compgen -W "status share isolate" -- "${cur}") )
            return 0
            ;;
        skills)
            COMPREPLY=( $(compgen -W "status share isolate" -- "${cur}") )
            return 0
            ;;
        color|stop|restart|delete|rename|clone)
            local profiles=$(multigravity list --raw 2>/dev/null)
            COMPREPLY=( $(compgen -W "${profiles}" -- "${cur}") )
            return 0
            ;;
    esac
}
complete -F _multigravity_completions multigravity
EOF
      ;;
  esac
}



interactive_menu() {
  if [ ! -d "$BASE" ]; then
    print_info "No profiles found."
    print_info "Create your first profile with: multigravity new <name>"
    return 0
  fi

  local profiles=()
  local dir
  for dir in "$BASE"/*; do
    [ -d "$dir" ] || continue
    local name
    name="$(basename "$dir")"
    [ "$name" = ".templates" ] && continue
    profiles+=("$name")
  done

  if [ ${#profiles[@]} -eq 0 ]; then
    print_info "No profiles found."
    print_info "Create your first profile with: multigravity new <name>"
    return 0
  fi

  echo ""
  echo "╔══════════════════════════════════════════════════════════════════╗"
  echo "║                       MULTIGRAVITY PROFILES                      ║"
  echo "╚══════════════════════════════════════════════════════════════════╝"
  echo ""

  local i=1
  for name in "${profiles[@]}"; do
    local status_dot="○ idle"
    if is_profile_running "$name"; then
      status_dot="● running"
    fi

    local type_str="isolated"
    if is_shared_profile "$name"; then
      type_str="shared"
    fi

    local color_str=""
    local custom_color
    custom_color="$(get_profile_color "$name")"
    if [ -n "$custom_color" ]; then
      color_str="[color: $custom_color]"
    fi

    printf "  \033[1;36m[%2d]\033[0m %-20s %-12s (%s) %s\n" "$i" "$name" "$status_dot" "$type_str" "$color_str"
    i=$((i + 1))
  done

  echo ""
  echo "  [n]  Create a new profile"
  echo "  [q]  Quit"
  echo ""
  printf "Select profile number or name: "

  local choice
  read -r choice || return 0

  case "$choice" in
    q|Q|"")
      return 0
      ;;
    n|N)
      echo ""
      printf "Enter new profile name: "
      local new_name
      read -r new_name || return 0
      if [ -n "$new_name" ]; then
        new_profile "$new_name"
      fi
      return 0
      ;;
    *)
      if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#profiles[@]}" ]; then
        local target_profile="${profiles[$((choice - 1))]}"
        echo ""
        print_info "Launching profile: $target_profile ..."
        launch_profile "$target_profile"
      elif profile_exists "$choice"; then
        echo ""
        print_info "Launching profile: $choice ..."
        launch_profile "$choice"
      else
        abort "invalid selection: $choice"
      fi
      ;;
  esac
}

usage() {
  cat <<EOF
Usage: multigravity <command> [args]

Commands:
  new <name> [options]        Create a new profile + desktop shortcut
      --shared                Share extensions & settings; isolate only accounts
      --from <template>       Seed from a saved template
      --isolated-dotfiles     Do not link system .gitconfig/.ssh into profile
      --isolated-mcp          Do not share system MCP server configurations
      --isolated-skills       Do not share system skills and plugins
      --color <color>         Set UI theme color (e.g. blue, green, red, "#1e3a8a")
  color <name> [color|--clear] View or change window theme color
  stop <name> [--force]       Stop a running profile gracefully
  restart <name> [args...]    Restart a profile
  clean <name|--all>          Clean profile caches to free up disk space
  list                        List existing profiles
  status                      Show running state, type, and last-used per profile
  rename <old> <new>          Rename a profile (updates its shortcut)
  delete <name> [--force]     Delete a profile and all its data
  clone <src> <dest>          Copy an existing profile
  template save <profile> <name>   Save a profile as a reusable template
  template list               List saved templates
  template delete <name>      Delete a template
  export <name> [path] [--include-cache] Archive a profile to tar.gz
  import <archive> [name]     Restore a profile from a tar.gz archive
  ai export <profile> [path]   Export AI conversations & brains (credentials sanitized)
  ai import <archive> <profile> Import AI conversations into an existing profile
  ai sync <src> <dest>        Synchronize AI conversations directly between two profiles
  ai list <profile>           List AI conversations in a profile
  mcp <status|share|isolate> <profile> Manage MCP server configuration sharing
  skills <status|share|isolate> <profile> Manage skills and plugins configuration sharing
  update                      Update multigravity to the latest version
  doctor                      Run a system diagnosis
  stats                       Show storage usage per profile
  completion                  Show setup instructions for shell completion
  version                     Show multigravity version
  <name> [args...]            Launch Antigravity with the given profile
  help                        Show this help

Profile names: alphanumeric and hyphens only (e.g. work, personal, test-1)

Environment:
  MULTIGRAVITY_APP      Override the Antigravity app path or command
  AGY_APP               Alias for MULTIGRAVITY_APP
  MULTIGRAVITY_HOME     Override the profile storage directory
EOF
}

case "$cmd" in
  version | --version | -v)
    version_cli
    ;;
  new)
    shift
    new_profile "$@"
    ;;
  color)
    profile_color_cmd "${2-}" "${3-}"
    ;;
  stop)
    shift
    stop_profile "$@"
    ;;
  restart)
    shift
    restart_profile "$@"
    ;;
  clean)
    shift
    clean_profile "$@"
    ;;
  list)
    list_profiles "${2-}"
    ;;
  status)
    status_profiles
    ;;
  rename)
    rename_profile "${2-}" "${3-}"
    ;;
  delete)
    shift
    delete_profile "$@"
    ;;
  clone)
    clone_profile "${2-}" "${3-}"
    ;;
  template)
    shift
    template_cmd "$@"
    ;;
  export)
    shift
    export_profile "$@"
    ;;
  import)
    import_profile "${2-}" "${3-}"
    ;;
  ai)
    shift
    ai_cmd "$@"
    ;;
  mcp)
    shift
    mcp_cmd "$@"
    ;;
  skills)
    shift
    skills_cmd "$@"
    ;;
  update)
    update_cli
    ;;
  doctor)
    doctor_cli
    ;;
  stats)
    profile_stats
    ;;
  completion)
    if [ -n "${2-}" ]; then
      generate_completion "$2"
    else
      help_completion
    fi
    ;;
  help | --help | -h)
    usage
    ;;
  "")
    if [ -t 0 ] && [ -t 1 ]; then
      interactive_menu
    else
      usage
      exit 1
    fi
    ;;
  *)
    launch_profile "$cmd" "${@:2}"
    ;;
esac
