    try:
        p_env = dict(os.environ)
        if p_dir:
            p_env["HOME"] = p_dir
        headless_proc = subprocess.Popen(cmd, env=p_env, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        try:
            os.set_blocking(headless_proc.stderr.fileno(), False)
        except Exception:
            pass
        stderr_buf = ""
        start_wait = time.time()
        while time.time() - start_wait < 5.0:
            if headless_proc.poll() is not None:
                break
            try:
                chunk = headless_proc.stderr.read()
                if chunk:
                    stderr_buf += chunk.decode("utf-8", errors="replace")
                    if "for HTTPS" in stderr_buf:
                        m = re.search(r"at (\d+) for HTTPS", stderr_buf)
                        if m:
                            test_p = int(m.group(1))
