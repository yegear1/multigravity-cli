# Discover running Language Server
port, csrf, pid = None, None, None
try:
    ps_out = subprocess.check_output(["ps", "-eo", "pid,ppid,args"]).decode("utf-8", errors="replace")
except Exception:
    ps_out = ""

for line in ps_out.splitlines():
    if "language_server" in line and "--csrf_token" in line:
        parts = line.strip().split(None, 2)
        if len(parts) < 3:
            continue
        m_pid, m_ppid, m_cmd = parts[0], parts[1], parts[2]
        m = re.search(r"--csrf_token\s+([a-f0-9-]+)", m_cmd)
        if not m:
            continue
        c = m.group(1)

        prof_name = None
        if m_ppid:
            try:
                p_cmd = subprocess.check_output(["ps", "-p", m_ppid, "-o", "args="]).decode("utf-8", errors="replace")
                pm = re.search(r"AntigravityProfiles/([^/ ]+)", p_cmd)
                if pm:
                    prof_name = pm.group(1)
            except Exception:
                pass
        if target_prof and prof_name != target_prof:
