        print(f"    Limit Quota:      {rem_frac * 100:.1f}% remaining | Resets in: {t_left}")
        print(f"    Reset Target:     {rst_str}")
        print(f"    Last Primed:      {last_p} (model: {last_m}{prompt_info})")
        print(f"    Cycle Status:     {c_status}")

    print("\n  Scheduled Watchdog:")
    cron_desc = 'Installed (Hourly, Weekly + 5h)' if (cron_installed and cron_has_5h) else ('Installed (Hourly, Weekly only)' if cron_installed else 'Not installed')
    systemd_desc = 'Active (Weekly + 5h)' if (systemd_active and systemd_has_5h) else ('Active (Weekly only)' if systemd_active else 'Not active / Not installed')
    print(f"    Crontab:          {cron_desc}")
    print(f"    Systemd Timer:    {systemd_desc}")
    print(f"    Prompts Catalog:  {prompts_file} ({len(prompt_pool)} prompts loaded)")
    print("")
    sys.exit(0)

# Action == "prime"
try:
    used_prompts = set()
    primed_providers = set()
    for cfg in BUCKET_CONFIGS:
        # Check if 5h bucket is requested
        if cfg.get("period") == "5h" and not include_5h and not force:
            continue

        b = buckets.get(cfg["bucket_id"])
        if not b:
            continue

        # Protection: if this is a 5h bucket, check if parent weekly quota has remaining quota (> 5%)
        if cfg.get("parent_key"):
            parent_b = buckets.get(cfg["parent_key"] + "-weekly")
            if parent_b:
                p_rem = float(parent_b.get("remainingFraction", 0.0))
                if p_rem <= 0.05 and not force:
                    if not quiet:
                        print(f"Skipping 5h prime for {cfg['name']}: weekly quota is exhausted ({p_rem * 100:.1f}% remaining).")
                    continue

        rem_frac = float(b.get("remainingFraction", 0.0))
        rst_str = b.get("resetTime")
        d_sec = 0
        t_left = ""
        if rst_str:
            try:
                rt = datetime.fromisoformat(rst_str.replace("Z", "+00:00"))
                d_sec = int((rt - now).total_seconds())
                if d_sec > 0:
                    t_left = f"{d_sec // 3600}h {(d_sec % 3600) // 60}m"
                else:
                    t_left = "Refreshed!"
            except Exception:
                t_left = str(rst_str)

        is_ref = (rem_frac >= 0.999) or (d_sec <= 0)
        b_state = prof_state.setdefault(cfg["key"], {})
        last_rst = b_state.get("last_reset_time")
        alr_primed = (last_rst == rst_str and rem_frac < 0.999)

        if not force:
            if alr_primed:
                if not quiet:
                    print(f"Quota for '{prof_key}' [{cfg['name']}] is already primed and active for this cycle.")
                    print(f"Current cycle resets in {t_left} ({rst_str}).")
                continue

            if not is_ref:
                if not quiet:
                    print(f"Quota for '{prof_key}' [{cfg['name']}] has not reset yet ({rem_frac * 100:.1f}% remaining, resets in {t_left}).")
                continue

            if check_only:
                if not quiet:
                    print(f"Quota for '{prof_key}' [{cfg['name']}] is READY for priming (Reset occurred / New cycle waiting).")
                continue

            # Check if this model provider was ALREADY primed in this exact run (e.g. weekly primed just now)
            if cfg["model"] in primed_providers:
                b_state["last_primed_at"] = datetime.now(timezone.utc).isoformat()
                b_state["last_reset_time"] = rst_str
                b_state["last_model"] = cfg["model_label"]
                b_state["last_prompt"] = f"(Linked with {cfg['parent_key']} prime)"
                b_state["target_prime_time"] = None
                b_state["status"] = "success"
                prof_state[cfg["key"]] = b_state
                state["profiles"][prof_key] = prof_state
                save_state(state)
                if not quiet:
                    print(f"✓ 5-Hour window for '{prof_key}' [{cfg['name']}] auto-linked with previous prime in this session.")
                continue

            # Anti-bot jitter per bucket
            bucket_max_jitter = min(max_jitter, 15.0) if cfg.get("period") == "5h" else max_jitter
            if not no_jitter and bucket_max_jitter > 0:
                target_str = b_state.get("target_prime_time")
                target_time = None
                if target_str:
                    try:
                        target_time = datetime.fromisoformat(target_str)
                    except Exception:
                        pass

                if not target_time or target_time < now - timedelta(hours=2):
                    jitter_sec = random.uniform(0, bucket_max_jitter * 60)
                    target_time = now + timedelta(seconds=jitter_sec)
                    b_state["target_prime_time"] = target_time.isoformat()
                    prof_state[cfg["key"]] = b_state
                    state["profiles"][prof_key] = prof_state
                    save_state(state)

                if now < target_time:
                    wait_s = int((target_time - now).total_seconds())
                    if quiet:
                        continue
                    else:
                        print(f"Anti-bot jitter for {cfg['name']}: waiting {wait_s // 60}m {wait_s % 60}s before priming (scheduled for {target_time.strftime('%H:%M:%S UTC')})...")
                        time.sleep(wait_s)

        # Last-mile pre-prime check: verify live telemetry before sending StartCascade
        manual_activity = False
        try:
            chk_req = urllib.request.Request(
                f"https://127.0.0.1:{port}/exa.language_server_pb.LanguageServerService/RetrieveUserQuotaSummary",
                data=b"{}",
                headers={"Content-Type": "application/json", "X-Codeium-Csrf-Token": csrf}
            )
            with urllib.request.urlopen(chk_req, context=ctx, timeout=3) as chk_r:
                chk_data = json.loads(chk_r.read().decode("utf-8"))
                for cg in chk_data.get("response", {}).get("groups", []):
                    for cb in cg.get("buckets", []):
                        if cb.get("bucketId") == cfg["bucket_id"]:
                            fresh_rem = float(cb.get("remainingFraction", 0.0))
                            fresh_rst = cb.get("resetTime")
                            # If quota dropped or resetTime changed and not force, user performed manual action
                            if not force and fresh_rem < 0.999 and (fresh_rst != rst_str or fresh_rem < rem_frac - 0.005):
                                manual_activity = True
                                if not quiet:
                                    print(f"Aborting prime for {cfg['name']}: manual user activity detected (quota now at {fresh_rem * 100:.1f}%).")
                                b_state["target_prime_time"] = None
                                save_state(state)
                                break
        except Exception:
            pass

        if manual_activity:
            continue

        # Select a prompt from catalog not yet used in this run
        available = [p for p in prompt_pool if p not in used_prompts]
        if not available:
            available = prompt_pool
        selected_prompt = random.choice(available)
        used_prompts.add(selected_prompt)

        try:
            start_req = urllib.request.Request(
                f"https://127.0.0.1:{port}/exa.language_server_pb.LanguageServerService/StartCascade",
                data=json.dumps({"source": "CORTEX_TRAJECTORY_SOURCE_CLI"}).encode("utf-8"),
                headers={"Content-Type": "application/json", "X-Codeium-Csrf-Token": csrf}
            )
            with urllib.request.urlopen(start_req, context=ctx, timeout=10) as r:
                start_res = json.loads(r.read().decode("utf-8"))
                cascade_id = start_res.get("cascadeId")

            msg_payload = {
                "cascadeId": cascade_id,
                "items": [{"text": selected_prompt}],
                "cascadeConfig": {
                    "plannerConfig": {
                        "requestedModel": {
                            "model": cfg["model"]
                        }
                    }
                }
            }
            msg_req = urllib.request.Request(
                f"https://127.0.0.1:{port}/exa.language_server_pb.LanguageServerService/SendUserCascadeMessage",
                data=json.dumps(msg_payload).encode("utf-8"),
                headers={"Content-Type": "application/json", "X-Codeium-Csrf-Token": csrf}
            )
            with urllib.request.urlopen(msg_req, context=ctx, timeout=10) as r:
                r.read()

            # Brief grace delay to allow the LLM response stream to finish saving in SQLite
            time.sleep(3)

            b_state["last_primed_at"] = datetime.now(timezone.utc).isoformat()
            b_state["last_reset_time"] = rst_str
            b_state["last_cascade_id"] = cascade_id
            b_state["last_model"] = cfg["model_label"]
            b_state["last_prompt"] = selected_prompt
            b_state["target_prime_time"] = None
            b_state["status"] = "success"
            prof_state[cfg["key"]] = b_state
            state["profiles"][prof_key] = prof_state
            save_state(state)
            primed_providers.add(cfg["model"])

            if not quiet:
                print(f"\n✓ Successfully primed quota for profile '{prof_key}' [{cfg['name']}]!")
                print(f"  Model: {cfg['model_label']} (minimum token cost)")
                print(f"  Prompt: \"{selected_prompt}\"")
                print(f"  Cascade ID: {cascade_id}")
                print("  Reset countdown has officially started!")
            else:
                print(f"[{datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S UTC')}] Primed {prof_key} [{cfg['name']}] with {cfg['model_label']}: \"{selected_prompt}\"")
        except Exception as e:
            if not quiet:
                print(f"Error priming {cfg['name']}: {e}", file=sys.stderr)
            else:
                print(f"[{datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S UTC')}] Error priming {prof_key} [{cfg['name']}]: {e}", file=sys.stderr)
finally:
    cleanup()
EOF
}

update_cli() {
  local repo="${MULTIGRAVITY_REPO:-yegear1/multigravity-cli}"
  local branch="${MULTIGRAVITY_BRANCH:-main}"
  local script_url="https://raw.githubusercontent.com/$repo/$branch/multigravity"
  local target
  target="$(script_path)"

  if [ -z "$target" ]; then
    abort "could not determine script path for update"
  fi

  print_info "Updating multigravity from $script_url ..."
  if curl -fsSL "$script_url" -o "$target.tmp"; then
    mv "$target.tmp" "$target"
    chmod +x "$target"
    print_info "Successfully updated multigravity!"
  else
    rm -f "$target.tmp"
    abort "failed to download update"
  fi
}

