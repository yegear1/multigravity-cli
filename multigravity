    p_dir = os.path.join(base_dir, target_prof) if target_prof and base_dir else ""
    p_gemini = os.path.join(p_dir, ".gemini") if p_dir else os.path.expanduser("~/.gemini")
    temp_csrf = str(uuid.uuid4())

    cmd = [
        ls_bin,
